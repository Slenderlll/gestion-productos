# Copia este archivo como .env y llena los valores. El archivo .env nunca se sube a Git.

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto del servidor local
PORT=3000

# Conexión a MongoDB: local o MongoDB Atlas (mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/gestion_productos)
MONGODB_URI=mongodb://127.0.0.1:27017/gestion_productos

# Clave para firmar los JWT (mínimo 32 caracteres). Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Vigencia del token (formato de jsonwebtoken: 30m, 2h, 1d...)
JWT_EXPIRA=2h

# Otros orígenes permitidos por CORS, separados por coma. Déjalo vacío si las vistas
# las sirve este mismo Express (el mismo origen siempre está permitido).
CORS_ORIGENES=

# Usuario administrador que crea "npm run seed"
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@productos.mx
ADMIN_PASSWORD=
